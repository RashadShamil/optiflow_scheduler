# Supabase project settings
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_BACKEND_KEY

# Comma-separated Flutter web origins in production. Use * for local development.
CORS_ORIGINS=*

# Shop planning calendar. Python weekday numbers: Monday=0 ... Sunday=6.
SHOP_TIMEZONE=Asia/Colombo
SHOP_OPEN_HOUR=8
SHOP_CLOSE_HOUR=18
SHOP_WORK_DAYS=0,1,2,3,4,5
MAX_PLANNING_DAYS=60

# Set true only for local API testing without Supabase login.
ALLOW_DEV_AUTH=false
